# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_discord_channel_id_here

# Stock API Configuration (Finnhub provides free real-time US stock quotes)
# Get a free key at https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_api_key_here

# Render HTTP Keep-Alive Server Port (Render sets this automatically to 10000)
PORT=10000

# How often to check stock prices in seconds (e.g. 60 seconds)
CHECK_INTERVAL_SECONDS=60

# Alert Cooldown in minutes per ticker (avoids pinging constantly on every minor tick)
ALERT_COOLDOWN_MINUTES=60
